{
  "name": "rv-catalog-studio",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 5174 --strictPort\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src server",
    "test:e2e": "pnpm build && playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "db:import-images": "tsx server/import-images.ts",
    "test:docker": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-table": "^8.21.3",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "he": "^2.0.0",
    "jsbarcode": "^3.12.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/he": "^1.2.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
